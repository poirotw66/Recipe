---
import RecipeCard from "./RecipeCard.astro";
import DinnerPicker from "./DinnerPicker.astro";
import { localePath, type Locale } from "../lib/i18n";
import { getHomePage } from "../i18n/home-page";
import { listRecipesForLocale } from "../lib/recipe-locale";
import { getFeaturedRecipes, getLatestRecipes } from "../lib/recipes";
import {
  getIngredientBySlug,
  getIngredientLabel,
  getPopularIngredients,
  getScenarioBySlug,
  getScenarioDescription,
  getScenarioLabel,
  ingredientRecipesLinkSeparator,
  scenarioItems
} from "../lib/taxonomy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getHomePage(locale);
const allRecipes = await listRecipesForLocale(locale);
const quickIngredients = getPopularIngredients(allRecipes, 6);
const featuredScenarios = scenarioItems.slice(0, 6);
const popularIngredients = getPopularIngredients(allRecipes, 8);
const featuredRecipes = getFeaturedRecipes(allRecipes, 3);
const popularRecipes = featuredRecipes.length > 0 ? featuredRecipes : getLatestRecipes(allRecipes, 3);
const fridgeToolPath = localePath(locale, "/tools/fridge-recipe");
const topicHubsInlineLinks = content.topicHubsInlineLinkRefs
  .map((ref) => {
    if (ref.kind === "ingredient") {
      const ingredient = getIngredientBySlug(ref.slug);
      return ingredient
        ? {
            href: localePath(locale, `/ingredients/${ingredient.slug}`),
            label: getIngredientLabel(ingredient, locale)
          }
        : null;
    }

    const scenario = getScenarioBySlug(ref.slug);
    return scenario
      ? {
          href: localePath(locale, `/scenarios/${scenario.slug}`),
          label: getScenarioLabel(scenario, locale)
        }
      : null;
  })
  .filter((link): link is NonNullable<typeof link> => Boolean(link));
---

<section class="hero home-decision">
  <div class="container home-decision__layout">
    <div class="home-decision__search">
    <div class="hero-intro">
      <p class="eyebrow">{content.heroEyebrow}</p>
      <h1 class="page-title">{content.heroTitle}</h1>
      <p class="page-copy">{content.heroCopy}</p>
    </div>

    <div class="search-panel">
      <form
        class="search-form"
        action={fridgeToolPath}
        method="get"
        data-home-search
        data-fridge-path={fridgeToolPath}
        data-error-empty={content.searchErrorEmpty}
        data-error-max={content.searchErrorMax}
      >
        <label class="field">
          <span class="eyebrow">{content.searchLabel}</span>
          <input
            name="ingredients"
            type="search"
            placeholder={content.searchPlaceholder}
            autocomplete="off"
            aria-describedby="home-search-error"
            data-home-search-input
          />
        </label>
        <button class="button primary" type="submit">{content.searchSubmit}</button>
      </form>
      <p class="form-error" id="home-search-error" role="alert" data-home-search-error hidden></p>

      <div class="chip-row" aria-label={content.quickIngredientsAriaLabel}>
        {
          quickIngredients.map((ingredient) => (
            <a
              class="chip note"
              href={`${fridgeToolPath}?ingredients=${encodeURIComponent(getIngredientLabel(ingredient, locale))}#fridge-results`}
            >
              {getIngredientLabel(ingredient, locale)}
            </a>
          ))
        }
      </div>
    </div>
    </div>
    <DinnerPicker recipes={allRecipes} locale={locale} />
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{content.scenariosEyebrow}</p>
      <h2>{content.scenariosTitle}</h2>
    </div>
    <div class="grid">
      {
        featuredScenarios.map((scenario) => (
          <a class="note-card card-body" href={localePath(locale, `/scenarios/${scenario.slug}`)}>
            <h3>{getScenarioLabel(scenario, locale)}</h3>
            <p>{content.scenarioDescriptions[scenario.slug] ?? getScenarioDescription(scenario, locale)}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{content.featuredEyebrow}</p>
      <h2>{content.featuredTitle}</h2>
    </div>
    <div class="grid">
      {popularRecipes.map((recipe) => <RecipeCard recipe={recipe} locale={locale} />)}
    </div>
    <p class="section-action">
      <a class="button" href={localePath(locale, "/recipes")}>{content.viewAllRecipes}</a>
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{content.topicHubsEyebrow}</p>
      <h2>{content.topicHubsTitle}</h2>
    </div>
    {topicHubsInlineLinks.length > 0 && (
      <p class="page-copy">
        {content.topicHubsInlineLinksLead}
        {topicHubsInlineLinks.map((link, index) => (
          <>
            {index > 0 ? ingredientRecipesLinkSeparator(locale) : " "}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
        {locale === "en" ? "." : "。"}
      </p>
    )}
    <div class="grid topic-hub-grid">
      {
        content.topicHubs.map((card) => (
          <a class="topic-card" href={localePath(locale, `/${card.slug}`)}>
            <span class="topic-card__label">{card.label}</span>
            <div
              class="topic-card__media"
              style={`background-image: url('${card.cover}')`}
              role="img"
              aria-label={`${card.title} preview`}
            />
            <div class="topic-card__body">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <span class="topic-card__cta">{content.enterTopicHub}</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{content.ingredientsEyebrow}</p>
      <h2>{content.ingredientsTitle}</h2>
    </div>
    <div class="chip-row" aria-label={content.ingredientsEyebrow}>
      {
        popularIngredients.map((ingredient) => (
          <a class="chip note" href={localePath(locale, `/ingredients/${ingredient.slug}`)}>
            {getIngredientLabel(ingredient, locale)}
          </a>
        ))
      }
    </div>
  </div>
</section>

<script is:inline src="/scripts/home-search.js"></script>

<style>
  .home-decision { padding: 32px 0; background: var(--note); border-bottom: 1px solid var(--bran-line); }
  .home-decision__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .home-decision__search { min-width: 0; }
  .hero-intro { margin-bottom: 28px; border: 0; padding: 0; }
  .hero-intro .eyebrow { color: var(--scallion-deep); }
  .page-title { font-size: clamp(2rem, 3.3vw, 2.8rem); line-height: 1.4; text-wrap: balance; }
  .page-copy { margin: 16px 0 0; max-width: 32em; }
  .search-panel { padding: 24px 0 0; border: 0; border-top: 1px solid var(--caramel-line); border-radius: 0; background: transparent; box-shadow: none; }
  .search-form { grid-template-columns: 1fr; gap: 12px; }
  .field .eyebrow { color: var(--soy-ink); font-size: .85rem; letter-spacing: 0; font-weight: 500; }
  .search-form input { border-radius: 6px; border-color: var(--caramel-line); background: var(--porcelain); }
  .search-form .button { min-height: 48px; border-radius: 6px; }
  .chip-row { margin-top: 16px; }
  .chip.note { background: var(--porcelain); border-color: var(--caramel-line); color: var(--soy-ink); }
  @media (max-width: 719px) {
    .home-decision { padding: 24px 0; }
    .home-decision__layout { grid-template-columns: 1fr; gap: 28px; }
    .hero-intro { margin-bottom: 20px; }
    .page-title { font-size: 1.9rem; }
    .page-copy { font-size: .9rem; }
    .search-panel { padding-top: 16px; }
  }
</style>
